# koturutin environment (example). Copy to .env.local and fill in when a Supabase project exists.
# The app runs fully local-first WITHOUT these; they only enable optional cloud sync.
#
# Only the PUBLISHABLE / ANON key belongs on the client (protected by RLS, not secrecy).
# NEVER put the service_role key here or anywhere in the app bundle — it lives only in
# Edge Function environments (AGENTS.md §8; spine §19).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
